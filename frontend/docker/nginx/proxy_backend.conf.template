## Proxy API calls to the backend service. The backend host suffix is derived
## from the active Spring profile (SPRING_PROFILES_ACTIVE), e.g. "dev".
##
## Requests to /api/backend/... will have the prefix stripped so the backend
## receives paths like /testdaten/...

# Handle exact prefix without trailing slash as well
location = /api/backend {
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://testdatengenerator-backend-${BACKEND_SUFFIX}:8080/;
}

location /api/backend/ {
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Trailing slash in proxy_pass ensures the matched prefix (/api/backend/) is
  # replaced with "/" so the backend sees the path without the prefix.
  proxy_pass http://testdatengenerator-backend-${BACKEND_SUFFIX}:8080/;
}
